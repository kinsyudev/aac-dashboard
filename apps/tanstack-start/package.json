{
  "name": "@acme/tanstack-start",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "pnpm with-env vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "test:regrade": "node --experimental-strip-types --test src/lib/regrade.test.ts src/lib/regrade-route-source.test.ts",
    "test:planner": "node --experimental-strip-types --test src/lib/costume-planner.test.ts",
    "test:shoplist-destinations": "node --experimental-strip-types --test src/lib/shoplist-destinations.test.ts",
    "test:trade-packs": "node --experimental-strip-types --test src/lib/trade-packs.test.ts",
    "test:craft-optimizer": "node --experimental-strip-types --test src/lib/craft-optimizer.test.ts",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@acme/api": "workspace:*",
    "@acme/auth": "workspace:*",
    "@acme/db": "workspace:*",
    "@acme/ui": "workspace:*",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@radix-ui/react-icons": "^1.3.2",
    "@t3-oss/env-core": "^0.13.8",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "^1.135.2",
    "@tanstack/react-router-devtools": "^1.135.2",
    "@tanstack/react-router-ssr-query": "^1.135.2",
    "@tanstack/react-start": "^1.135.2",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@trpc/tanstack-react-query": "catalog:",
    "better-auth": "catalog:",
    "lucide-react": "^1.8.0",
    "nitro": "3.0.1-alpha.1",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "superjson": "2.2.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@acme/eslint-config": "workspace:*",
    "@acme/prettier-config": "workspace:*",
    "@acme/tailwind-config": "workspace:*",
    "@acme/tsconfig": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "prettier": "@acme/prettier-config"
}
